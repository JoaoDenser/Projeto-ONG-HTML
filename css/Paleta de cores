:root {
    /* Cores primárias */
    --cor-primaria: #2E7D32;
    --cor-secundaria: #81C784;
    --cor-terciaria: #1B5E20;

    /* Cores complementares */
    --cor-destaque: #FFC107;
    --cor-fundo: #F1F8E9;
    --cor-branco: #FFFFFF;

    /* Tons neutros */
    --cor-texto: #212121;
    --cor-texto-secundario: #616161;
    --cor-borda: #D6D6D6;
}
